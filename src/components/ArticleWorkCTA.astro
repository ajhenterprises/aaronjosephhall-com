---
// Shown at both the top and bottom of every article, per site owner
// request, pointing readers toward website/content work. Styled distinctly
// from AffiliateDisclosure (pine instead of clay) so the two don't blend.
interface Props {
  variant?: "top" | "bottom";
}

const { variant = "top" } = Astro.props;
---

<div
  class:list={[
    "not-prose flex flex-wrap items-center justify-between gap-4 rounded-xl border-2 border-pine bg-pine/5 px-5 py-4",
    variant === "top" ? "mb-8" : "mt-12",
  ]}
>
  <p class="text-sm text-ink-soft">
    <strong class="text-ink">Need a website?</strong> I build fast, modern sites and write the words that go on them.
  </p>
  <a
    href="/work-with-me"
    class="shrink-0 rounded-full bg-pine text-parchment px-5 py-2.5 text-sm font-medium hover:bg-pine-dark transition-colors"
  >
    See my services &rarr;
  </a>
</div>
