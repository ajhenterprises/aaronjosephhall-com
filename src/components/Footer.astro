---
import { NAV_LINKS, SITE, SOCIAL_LINKS } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-stone-light/60 mt-24">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-display text-lg text-ink">{SITE.name}</p>
      <p class="mt-2 text-sm text-stone max-w-xs">{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p class="eyebrow mb-3">Site</p>
      <ul class="space-y-2">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="text-ink-soft hover:text-clay-dark">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <p class="eyebrow mb-3">Connect</p>
      <ul class="space-y-2">
        <li><a href={`mailto:${SITE.email}`} class="text-ink-soft hover:text-clay-dark">{SITE.email}</a></li>
        <li><a href="/rss.xml" class="text-ink-soft hover:text-clay-dark">RSS feed</a></li>
        {SOCIAL_LINKS.map((s) => (
          <li><a href={s.href} target="_blank" rel="noreferrer" class="text-ink-soft hover:text-clay-dark">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-6 text-center">
      <p class="text-sm text-ink-soft">
        Do you need a website? I can build one for you! <a href="/contact" class="font-medium text-clay-dark hover:underline">Contact me today!</a>
      </p>
    </div>
  </div>

  <div class="border-t border-stone-light/60">
    <div class="mx-auto max-w-6xl px-6 py-5 text-xs text-stone flex flex-wrap gap-x-4 gap-y-1 justify-between">
      <p>&copy; {year} AJH Enterprises, LLC. All rights reserved.</p>
    </div>
  </div>
</footer>
