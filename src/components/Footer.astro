---
import { LEGAL_LINKS, NAV_LINKS, SITE, SOCIAL_LINKS } from "@/data/site";
import NewsletterForm from "@/components/NewsletterForm.astro";

interface Props {
  /** Omit the embedded newsletter form, e.g. on a page that already features it. */
  hideNewsletterForm?: boolean;
}

const { hideNewsletterForm = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 mt-24">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <p class="font-display text-lg text-ink">{SITE.name}</p>
      <p class="mt-2 text-sm text-stone max-w-xs">{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p class="eyebrow mb-3">Site</p>
      <ul class="space-y-2">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="text-ink-soft hover:text-clay">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <p class="eyebrow mb-3">Connect</p>
      <ul class="space-y-2">
        <li><a href={`mailto:${SITE.email}`} class="text-ink-soft hover:text-clay">{SITE.email}</a></li>
        <li><a href="/rss.xml" class="text-ink-soft hover:text-clay">RSS feed</a></li>
        {SOCIAL_LINKS.map((s) => (
          <li><a href={s.href} target="_blank" rel="noreferrer" class="text-ink-soft hover:text-clay">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <nav aria-label="Legal" class="text-sm">
      <p class="eyebrow mb-3">Legal</p>
      <ul class="space-y-2">
        {LEGAL_LINKS.map((link) => (
          <li><a href={link.href} class="text-ink-soft hover:text-clay">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="bg-pine">
    {!hideNewsletterForm && (
      <div class="border-b border-parchment/15">
        <div class="mx-auto max-w-6xl px-6 py-14 flex justify-center">
          <NewsletterForm />
        </div>
      </div>
    )}

    <div class="mx-auto max-w-6xl px-6 py-6 text-center">
      <p class="text-sm text-parchment/90">
        Do you need a website? I can build one for you! <a href="/contact" class="font-medium text-brass-light hover:underline">Contact me today!</a>
      </p>
    </div>
  </div>

  <div class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-5 text-xs text-stone flex flex-wrap gap-x-4 gap-y-1 justify-between">
      <p>&copy; {year} AJH Enterprises, LLC. All rights reserved.</p>
    </div>
  </div>
</footer>
