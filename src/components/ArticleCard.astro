---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/format";

interface Props {
  entry: CollectionEntry<"articles">;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, date, category, excerpt, image, imageAlt } = entry.data;
---

<a
  href={`/articles/${entry.id}`}
  class:list={[
    "group block rounded-lg border border-stone-light/70 bg-white/40 overflow-hidden transition-shadow hover:shadow-md",
    featured ? "md:grid md:grid-cols-2 md:gap-0" : "",
  ]}
>
  <div class:list={["aspect-[16/10] bg-parchment-dim overflow-hidden", featured ? "md:aspect-auto md:h-full" : ""]}>
    {image ? (
      <Image
        src={image}
        alt={imageAlt ?? title}
        width={featured ? 900 : 600}
        height={featured ? 700 : 375}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center text-stone">
        <span class="font-display text-3xl opacity-40">AJH</span>
      </div>
    )}
  </div>
  <div class:list={["p-6", featured ? "md:p-10 md:flex md:flex-col md:justify-center" : ""]}>
    <p class="eyebrow">{category ?? "Category pending"}</p>
    <h3 class:list={["mt-2 font-display text-ink group-hover:text-clay-dark transition-colors", featured ? "text-3xl" : "text-xl"]}>
      {title}
    </h3>
    <p class:list={["mt-3 text-stone", featured ? "text-base" : "text-sm line-clamp-3"]}>{excerpt}</p>
    {date ? (
      <time datetime={date.toISOString()} class="mt-4 block text-xs text-stone">
        {formatDate(date)}
      </time>
    ) : (
      <p class="mt-4 block text-xs text-stone italic">Date pending</p>
    )}
  </div>
</a>
