---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/format";

export async function getStaticPaths() {
  const media = await getCollection("media");
  return media.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, type, embedUrl, excerpt, seoTitle, seoDescription, contentPending } = entry.data;
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? excerpt}
  path={`/media/${entry.id}`}
>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="eyebrow">{type}</p>
    <h1 class="mt-3 text-4xl md:text-5xl">{title}</h1>
    {date ? (
      <time datetime={date.toISOString()} class="mt-4 block text-sm text-stone">{formatDate(date)}</time>
    ) : (
      <p class="mt-4 text-sm text-stone italic">Date pending</p>
    )}

    {embedUrl ? (
      <div class="mt-10 aspect-video rounded-lg overflow-hidden border border-stone-light/70">
        <iframe src={embedUrl} title={title} class="h-full w-full" loading="lazy" allowfullscreen></iframe>
      </div>
    ) : (
      <div class="mt-10 aspect-video rounded-lg border border-dashed border-stone-light bg-parchment-dim/60 flex items-center justify-center text-stone text-sm">
        Media embed pending
      </div>
    )}

    <div class="prose-article mt-10">
      {contentPending && (
        <p class="content-pending-notice not-prose mb-8">
          <strong>Content pending.</strong> This entry was seeded from the verified migration inventory and is
          still waiting on the original copy and embed from aaronjosephhall.com.
        </p>
      )}
      <Content />
    </div>

    <div class="mt-16 border-t border-stone-light/60 pt-10">
      <a href="/media" class="text-sm font-medium text-clay-dark hover:underline">&larr; All media</a>
    </div>
  </article>
</BaseLayout>
