---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPendingNotice from "@/components/ContentPendingNotice.astro";
---

<BaseLayout
  title="About"
  description="About Aaron Joseph Hall — pastor, author, speaker, teacher, and leadership writer."
  path="/about"
>
  <section class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <p class="eyebrow">About</p>
    <h1 class="mt-3 text-4xl md:text-5xl">About Aaron</h1>

    <div class="prose-article mt-10">
      <ContentPendingNotice />
      <p>
        The live site's About page copy — biography, family, ministry background — is still pending
        verbatim migration. Nothing here is final; do not replace this note with invented biography.
      </p>
    </div>
  </section>
</BaseLayout>
