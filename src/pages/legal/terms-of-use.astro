---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms of Use"
  description="Terms governing use of this website."
  path="/legal/terms-of-use"
>
  <section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-3 text-4xl md:text-5xl">Terms of Use</h1>
    <p class="mt-4 text-stone text-lg">Terms governing use of this website.</p>

    <div class="prose-article mt-10">
      <p>
        All content on this website is the property of Aaron Joseph Hall unless otherwise noted.
        You are welcome to quote briefly with attribution and a link. Reproduction of full
        articles or resources without permission is not permitted. This site is provided as-is
        without warranty.
      </p>
    </div>
  </section>
</BaseLayout>
