---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="How information is collected and used on this website."
  path="/legal/privacy-policy"
>
  <section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-3 text-4xl md:text-5xl">Privacy Policy</h1>
    <p class="mt-4 text-stone text-lg">How information is collected and used on this website.</p>

    <div class="prose-article mt-10">
      <p>
        This website collects only the information you choose to provide through its forms—your
        name, email address, and the details of your message or request. That information is
        used to respond to you and, if you subscribe, to send occasional email updates. It is
        never sold. You may request removal at any time by using the contact form.
      </p>
      <p>
        This site uses essential cookies to keep it working properly, and optional analytics
        cookies to understand how it's used. You choose which are allowed when you visit.
      </p>
    </div>
  </section>
</BaseLayout>
