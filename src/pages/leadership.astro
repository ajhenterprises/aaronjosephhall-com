---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ContentPendingNotice from "@/components/ContentPendingNotice.astro";

const leadershipArticles = (await getCollection("articles", ({ data }) => data.category === "Leadership")).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);

const leadWell = (await getCollection("speaking")).find((s) => s.id === "lead-well");
const redeemTheStory = (await getCollection("speaking")).find((s) => s.id === "redeem-the-story");
---

<BaseLayout
  title="Leadership"
  description="Christian leadership teaching, writing, and speaking from Aaron Joseph Hall."
  path="/leadership"
>
  <section class="border-b border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Leadership</p>
      <h1 class="mt-3 text-4xl md:text-5xl max-w-2xl">Leadership, formed by the gospel.</h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <ContentPendingNotice />
    <p class="prose-article mt-8">
      The live Leadership page positions Christian leadership and names who it's for in its own words.
      That intro copy is still pending — do not replace this note until the verbatim text is confirmed.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <p class="eyebrow mb-6">Teaching &amp; speaking sessions</p>
    <ul class="grid gap-6 sm:grid-cols-2">
      {[leadWell, redeemTheStory].filter(Boolean).map((topic) => topic && (
        <li>
          <a href={`/speaking/${topic.id}`} class="group block rounded-lg border border-stone-light/70 bg-white/40 p-6 hover:shadow-md transition-shadow">
            <h2 class="font-display text-xl group-hover:text-clay-dark">{topic.data.title}</h2>
            <p class="mt-2 text-sm text-stone">{topic.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="eyebrow mb-6">Leadership articles</p>
      {leadershipArticles.length > 0 ? (
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {leadershipArticles.map((entry) => <li><ArticleCard entry={entry} /></li>)}
        </ul>
      ) : (
        <p class="text-stone text-sm">
          No articles are tagged "Leadership" yet — categories for the four verified articles are still
          pending confirmation.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
