---
export const prerender = true;
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  subtitle,
  excerpt,
  isbn10,
  isbn13,
  pageCount,
  publisher,
  publishDate,
  purchaseLinks,
  seoTitle,
  seoDescription,
  contentPending,
} = entry.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: title,
  ...(subtitle ? { alternateName: subtitle } : {}),
  author: { "@type": "Person", name: SITE.name },
  ...(isbn13 ? { isbn: isbn13 } : isbn10 ? { isbn: isbn10 } : {}),
  ...(pageCount ? { numberOfPages: pageCount } : {}),
  ...(publisher ? { publisher: { "@type": "Organization", name: publisher } } : {}),
};
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? excerpt}
  path={`/books/${entry.id}/`}
  structuredData={jsonLd}
>
  <article class="mx-auto max-w-4xl px-6 py-16 md:py-24 grid gap-10 md:grid-cols-[240px_1fr]">
    <div class="w-full aspect-[2/3] bg-parchment-dim border border-ink/10 rounded flex items-center justify-center">
      <span class="font-display text-stone text-sm px-4 text-center opacity-60">Cover image pending</span>
    </div>

    <div>
      <p class="eyebrow">Book</p>
      <h1 class="mt-3 text-4xl md:text-5xl">{title}</h1>
      {subtitle && <p class="mt-2 text-xl text-stone">{subtitle}</p>}

      {(isbn10 || isbn13 || pageCount || publisher || publishDate) && (
        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-stone max-w-sm">
          {publisher && <><dt class="font-medium text-ink-soft">Publisher</dt><dd>{publisher}</dd></>}
          {publishDate && <><dt class="font-medium text-ink-soft">Published</dt><dd>{publishDate.getFullYear()}</dd></>}
          {pageCount && <><dt class="font-medium text-ink-soft">Pages</dt><dd>{pageCount}</dd></>}
          {isbn13 && <><dt class="font-medium text-ink-soft">ISBN-13</dt><dd>{isbn13}</dd></>}
          {isbn10 && <><dt class="font-medium text-ink-soft">ISBN-10</dt><dd>{isbn10}</dd></>}
        </dl>
      )}

      {purchaseLinks.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-3">
          {purchaseLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer" class="rounded-full bg-clay text-parchment px-5 py-2.5 text-sm font-medium hover:bg-clay-dark transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      )}

      <div class="prose-article mt-10">
        {contentPending && (
          <p class="content-pending-notice not-prose mb-8">
            <strong>Content pending.</strong> Description, ISBN, page count, and purchase links from the
            live /books/{entry.id}/ page still need to be migrated verbatim.
          </p>
        )}
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
