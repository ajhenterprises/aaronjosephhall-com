---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const topics = (await getCollection("speaking")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Speaking"
  description="Aaron Joseph Hall speaks on leadership, story, and church planting for churches, teams, and organizations."
  path="/speaking"
>
  <section class="border-b border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Speaking</p>
      <h1 class="mt-3 text-4xl md:text-5xl max-w-2xl">Bring Aaron in to teach, preach, or lead your team.</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <ul class="grid gap-8 md:grid-cols-3">
      {topics.map((topic) => (
        <li>
          <a href={`/speaking/${topic.id}`} class="group block h-full rounded-lg border border-stone-light/70 bg-white/40 p-8 transition-shadow hover:shadow-md">
            <h2 class="font-display text-2xl text-ink group-hover:text-clay-dark">{topic.data.title}</h2>
            <p class="mt-3 text-stone text-sm">{topic.data.excerpt}</p>
            <span class="mt-5 inline-block text-sm font-medium text-clay-dark">Learn more &rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 rounded-lg border border-dashed border-stone-light bg-parchment-dim/60 p-8">
      <h2 class="font-display text-xl">Other topics</h2>
      <p class="mt-2 text-stone text-sm max-w-2xl">
        The live site's speaking index includes "Other Topics" as a flexible catch-all option.
        Preserved here as a note until confirmed whether it points to a dedicated page, a form, or
        general availability language — flag the intended behavior and I'll build it out.
      </p>
    </div>
  </section>
</BaseLayout>
