---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const topics = await getCollection("speaking");
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, excerpt, seoTitle, seoDescription, contentPending } = entry.data;
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? excerpt}
  path={`/speaking/${entry.id}`}
>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="eyebrow">Speaking</p>
    <h1 class="mt-3 text-4xl md:text-5xl">{title}</h1>

    <div class="prose-article mt-10">
      {contentPending && (
        <p class="content-pending-notice not-prose mb-8">
          <strong>Content pending.</strong> This topic page was seeded from the verified migration inventory
          and is still waiting on the original body copy from aaronjosephhall.com.
        </p>
      )}
      <Content />
    </div>

    <div class="mt-16 border-t border-stone-light/60 pt-10">
      <a href="/speaking" class="text-sm font-medium text-clay-dark hover:underline">&larr; All speaking topics</a>
    </div>
  </article>
</BaseLayout>
