---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPendingNotice from "@/components/ContentPendingNotice.astro";

// Area list confirmed from the live site's migration inventory.
const areas = [
  "Pastoral Ministry",
  "Church Planting",
  "Leadership Development",
  "Coaching, Training & Teaching",
];
---

<BaseLayout
  title="Ministry"
  description="Pastoral ministry, church planting, leadership development, and coaching/training/teaching from Aaron Joseph Hall."
  path="/ministry"
>
  <section class="border-b border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Ministry</p>
      <h1 class="mt-3 text-4xl md:text-5xl max-w-2xl">Ministry</h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <ContentPendingNotice />

    <p class="prose-article mt-8">
      Intro copy for the Ministry page is still pending from the live site — do not replace this
      note until the verbatim text is confirmed.
    </p>

    <div class="mt-12">
      <p class="eyebrow mb-5">Areas</p>
      <ul class="grid gap-6 sm:grid-cols-2">
        {areas.map((area) => (
          <li class="rounded-lg border border-stone-light/70 bg-white/40 p-6">
            <h2 class="font-display text-xl">{area}</h2>
            <p class="mt-2 text-sm text-stone italic">Description pending.</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
