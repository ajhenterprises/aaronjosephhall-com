---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { SITE } from "@/data/site";

const latestArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 6);

const [featuredBook] = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const bookSummary = featuredBook
  ? [featuredBook.data.title, featuredBook.data.subtitle].filter(Boolean).join(": ")
  : "Books";
---

<BaseLayout
  title={SITE.name}
  description="Aaron Joseph Hall is a pastor, husband, father, and author. His ministry blog covers life, faith, family, ministry, and technology, alongside the website development, hosting, and content + copywriting work he does."
  path="/"
>
  <section class="border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-32 grid gap-10 md:grid-cols-[1.3fr_1fr] items-end">
      <div>
        <p class="eyebrow">Pastor &middot; Husband &middot; Father &middot; Author &middot; Speaker</p>
        <h1 class="mt-4 text-5xl md:text-6xl leading-[0.95]">{SITE.name}</h1>
        <p class="mt-6 max-w-xl text-lg text-stone">
          I'm a pastor, husband, father, and author. This is my ministry blog — writing on life,
          faith, family, ministry, and technology — alongside the digital media work I do: website
          development &amp; hosting, and content + copywriting.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/articles" class="rounded-full bg-clay text-parchment px-6 py-3 text-sm font-medium hover:bg-clay-dark transition-colors">
            Read the writing
          </a>
          <a href="/work-with-me" class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink hover:border-ink hover:bg-ink/5 transition-colors">
            Work with me
          </a>
        </div>
      </div>
      <div class="aspect-square overflow-hidden rounded-lg bg-parchment-dim">
        <img
          src="/AaronJosephHall.jpg"
          alt={SITE.name}
          width="1500"
          height="1501"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="eyebrow mb-8">Latest writing</p>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {latestArticles.map((entry) => <li><ArticleCard entry={entry} /></li>)}
    </ul>
    <div class="mt-12 flex justify-center">
      <a href="/articles" class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink hover:border-ink hover:bg-ink/5 transition-colors">
        View All Writings
      </a>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {[
        {
          label: "Speaking",
          href: "/speaking",
          copy: "Aaron speaks on Leadership, Church Planting, Faith, Culture, and more, bringing honest conversations and practical biblical insight to churches, conferences, and events.",
        },
        { label: "Books", href: "/books", copy: bookSummary },
        { label: "Work With Me", href: "/work-with-me", copy: "Website development & hosting, and content + copywriting." },
        { label: "Newsletter", href: "/newsletter", copy: "Get new writing and updates in your inbox." },
      ].map((card) => (
        <a href={card.href} class="group block rounded-2xl border border-ink/10 bg-white shadow-sm p-6 hover:shadow-md transition-shadow">
          <h2 class="font-display text-xl group-hover:text-clay">{card.label}</h2>
          <p class="mt-2 text-sm text-stone">{card.copy}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
