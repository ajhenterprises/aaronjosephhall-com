---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPendingNotice from "@/components/ContentPendingNotice.astro";

// Service list confirmed from the live site's migration inventory.
// Descriptive copy for each service is still pending — do not invent it.
const services = [
  "Content Strategy",
  "Copywriting",
  "Content-Level SEO",
  "Website Content & Management",
];
---

<BaseLayout
  title="Consulting"
  description="Content strategy, copywriting, content-level SEO, and website content consulting from Aaron Joseph Hall."
  path="/consulting"
>
  <section class="border-b border-stone-light/60 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Consulting</p>
      <h1 class="mt-3 text-4xl md:text-5xl max-w-2xl">Consulting</h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <ContentPendingNotice />

    <p class="prose-article mt-8">
      Intro copy for the Consulting page is still pending from the live site — do not replace this
      note until the verbatim text is confirmed.
    </p>

    <div class="mt-12">
      <p class="eyebrow mb-5">Service areas</p>
      <ul class="grid gap-6 sm:grid-cols-2">
        {services.map((service) => (
          <li class="rounded-lg border border-stone-light/70 bg-white/40 p-6">
            <h2 class="font-display text-xl">{service}</h2>
            <p class="mt-2 text-sm text-stone italic">Description pending.</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14">
      <a href="/contact" class="inline-block rounded bg-ink text-parchment px-6 py-3 text-sm font-medium hover:bg-clay-dark transition-colors">
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>
