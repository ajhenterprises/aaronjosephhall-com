---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/data/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Aaron Joseph Hall."
  path="/contact"
>
  <section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-4xl md:text-5xl">Get in touch</h1>
    <p class="mt-6 text-stone text-lg">
      For speaking, ministry, or website & content work inquiries, reach out directly.
    </p>

    <div class="mt-10 rounded-lg border border-dashed border-stone-light bg-parchment-dim/60 p-6 text-sm text-stone">
      This site is static, so the original contact form (if any) needs a form backend
      (e.g. Formspree, Resend, or a Vercel serverless function acting only as a mail relay —
      no database involved). Confirm whether the live site used a form or a plain mailto link,
      and I'll wire up the equivalent here.
    </div>

    <a
      href={`mailto:${SITE.email}`}
      class="mt-8 inline-block rounded bg-ink text-parchment px-6 py-3 text-sm font-medium hover:bg-clay-dark transition-colors"
    >
      {SITE.email}
    </a>
  </section>
</BaseLayout>
