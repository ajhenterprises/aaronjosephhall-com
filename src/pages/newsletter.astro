---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
---

<BaseLayout
  title="Newsletter"
  description="Sign up for Aaron Joseph Hall's newsletter."
  path="/newsletter"
  hideNewsletterForm
>
  <section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
    <p class="eyebrow">Newsletter</p>
    <h1 class="mt-3 text-4xl md:text-5xl">Stay in touch</h1>

    <div class="mt-10 flex justify-center">
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
